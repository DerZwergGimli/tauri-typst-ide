{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "shadcnVue": {
      "type": "local",
      "enabled": true,
      "command": [
        "npx",
        "shadcn-vue@latest",
        "mcp"
      ]
    },
    "vue-docs": {
      "type": "remote",
      "url": "https://mcp.vue-mcp.org/mcp",
      "enabled": true
    }
  }
}
